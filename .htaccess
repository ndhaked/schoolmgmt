<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the request is not already for the /public/ folder, and the file
    # doesn't exist as-is, quietly serve it from /public/ instead — the
    # browser's address bar never shows "/public/".
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
